// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Funcionario {
  id           Int       @id @default(autoincrement())
  nome         String    @unique
  senha        String
  // email        String @unique
  departamento String
  // cpf          Int 
  chamados     Chamado[]
}

model Chamado {
  id             Int               @id @default(autoincrement())
  categoria      CategoriaProblema
  descricao      String
  status         Status
  prioridade     Prioridade
  dataAbertura   DateTime?         @default(now())
  dataFechamento DateTime?
  sala           String
  titulo         String
  setor          String?
  funcionarioId  Int?

  funcionario Funcionario? @relation(fields: [funcionarioId], references: [id])
}

model Tecnico {
  id          Int    @id @default(autoincrement())
  email       String @unique
  nome        String
  status      String // (disponivel, indisponivel)
  habilidades String
  cpf         String
  senha       String
}

enum Status {
  ABERTO
  EM_ANDAMENTO
  FECHADO
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
}

enum Role {
  ADMIN
  FUNCIONARIO
  SUPORTE
}

enum CategoriaProblema {
  INFORMATICA
  PRODUCAO
  ADMINITRATIVO
}
